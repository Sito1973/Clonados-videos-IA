# Obtain your own keys. Never share a populated .env.
ENHANCOR_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
# kie.ai key: Seedance 2.5 with SEEDANCE_PROVIDER=kie, vocal separation with AUDIO_SEPARATION=kie.
KIE_API_KEY=
# enhancor or kie. Empty: kie when only KIE_API_KEY is set, otherwise enhancor.
SEEDANCE_PROVIDER=
# replicate (Demucs) or kie. Empty: kie when KIE_API_KEY is set and REPLICATE_API_TOKEN is not.
AUDIO_SEPARATION=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor. Leave blank to use PUBLIC_BASE_URL or the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# self (signed links served by this app; needs PUBLIC_BASE_URL), tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=
# Hosted deployment (VPS / EasyPanel): see docs/DEPLOY-EASYPANEL.md.
# Binding beyond 127.0.0.1 requires APP_PASSWORD. The Docker image sets APP_HOST=0.0.0.0.
APP_HOST=127.0.0.1
APP_PASSWORD=
# Public HTTPS address of this app, e.g. https://video.example.com (signed media links and provider callbacks).
PUBLIC_BASE_URL=
# Optional signing secret; empty creates runs/.app-secret. Keep runs/ on a persistent volume.
APP_SECRET=
MEDIA_LINK_HOURS=168
